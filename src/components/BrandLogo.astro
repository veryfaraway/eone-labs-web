---
interface Props {
  size?: number;
  class?: string;
}

const { size = 26, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  fill="none"
  class={`inline-block shrink-0 ${className}`}
  aria-hidden="true"
>
  <!-- Base circle badge -->
  <circle cx="50" cy="50" r="46" class="fill-[#111218] dark:fill-[#0e1015]" />
  <circle cx="50" cy="50" r="45" class="stroke-[#2b2e3c] dark:stroke-[#333746]" stroke-width="2" />

  <!-- Spinner rotational orbit accents -->
  <circle
    cx="50"
    cy="50"
    r="39"
    stroke="#ffffff"
    stroke-width="2.5"
    stroke-dasharray="65 180"
    stroke-linecap="round"
    opacity="0.9"
    transform="rotate(-60 50 50)"
  />
  <circle
    cx="50"
    cy="50"
    r="39"
    stroke="#ffffff"
    stroke-width="1.5"
    stroke-dasharray="25 220"
    stroke-linecap="round"
    opacity="0.45"
    transform="rotate(110 50 50)"
  />

  <!-- Tilted rotating 'e' glyph -->
  <g transform="rotate(-22 50 50)">
    <path
      d="M 33 50 L 67 50 A 17 17 0 1 0 62 62"
      stroke="#ffffff"
      stroke-width="7.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </g>
</svg>
